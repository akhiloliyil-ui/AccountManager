# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in apps/web/.data/pglite.
# Set it to use a PostgreSQL server instead, e.g. the one from docker-compose.yml:
# DATABASE_URL=postgres://gpa:gpa@localhost:5434/gpa_money
DATABASE_URL=

# Folder for the embedded database when DATABASE_URL is empty (relative to apps/web).
# PGLITE_DIR=.data/pglite

# Household time zone: decides what "today", this week and this month are.
TZ=Asia/Dubai

# Set to 1 once to load demo accounts and three months of transactions on an empty database.
# GPA_SEED_DEMO=1
